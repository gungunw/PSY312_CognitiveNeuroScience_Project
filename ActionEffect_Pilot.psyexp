    <Flow>
        <Routine name="Instructions"/>
        <LoopInitiator name="practice_loop" plugin="None" loopType="TrialHandler">
            <Param name="name" val="practice_loop" valType="code" updates="None" plugin="None"/>
            <Param name="loopType" val="sequential" valType="str" updates="None" plugin="None"/>
            <Param name="isTrials" val="True" valType="bool" updates="None" plugin="None"/>
            <Param name="conditionsFile" val="" valType="file" updates="None" plugin="None"/>
            <Param name="nReps" val="8" valType="code" updates="None" plugin="None"/>
            <Param name="Selected rows" val="" valType="code" updates="None" plugin="None"/>
            <Param name="random seed" val="" valType="code" updates="None" plugin="None"/>
            <Param name="conditions" val="[]" valType="str" updates="None" plugin="None"/>
            <Param name="endPoints" val="[0,1]" valType="code" updates="None" plugin="None"/>
        </LoopInitiator>
        <Routine name="Practice_Round"/>
        <LoopTerminator name="practice_loop"/>
        <Routine name="Post_practice_Instructions"/>
        <LoopInitiator name="trials" plugin="None" loopType="TrialHandler">
            <Param name="name" val="trials" valType="code" updates="None" plugin="None"/>
            <Param name="loopType" val="sequential" valType="str" updates="None" plugin="None"/>
            <Param name="isTrials" val="True" valType="bool" updates="None" plugin="None"/>
            <Param name="conditionsFile" val="conditions_revised_final.xlsx" valType="file" updates="None" plugin="None"/>
            <Param name="nReps" val="1" valType="code" updates="None" plugin="None"/>
            <Param name="Selected rows" val="" valType="code" updates="None" plugin="None"/>
            <Param name="random seed" val="" valType="code" updates="None" plugin="None"/>
            <Param name="conditions" val="[]" valType="str" updates="None" plugin="None"/>
            <Param name="endPoints" val="[0,1]" valType="code" updates="None" plugin="None"/>
        </LoopInitiator>
        <Routine name="trial"/>
        <Routine name="Consequence"/>
        <LoopTerminator name="trials"/>
    </Flow>
</PsychoPy2experiment>